                },
                "name": {
                    "type": "string"
                },
                "state": {
                    "type": "string"
                },
                "state_abbr": {
                    "type": "string"
                }
            }
        },
        "models.Image": {
            "title": "Image",
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer",
                    "format": "int64"
                },
                "images": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "models.PropertyInfo": {
            "title": "PropertyInfo",
            "type": "object",
            "properties": {
                "amenities": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "counts": {
                    "$ref": "#/definitions/models.Counts"
                },
                "image": {
                    "$ref": "#/definitions/models.Image"
                },
                "name": {
                    "type": "string"
                },
                "price": {
                    "type": "number",
                    "format": "double"
                },
                "property_type": {
                    "type": "string"
                },
                "review_score": {
                    "type": "number",
                    "format": "double"
                },
                "slug": {
                    "type": "string"
                },
                "star_rating": {
                    "type": "integer",
                    "format": "int64"
                }
            }
        },
        "models.PropertyListResponse": {
            "title": "PropertyListResponse",
            "type": "object",
            "properties": {
                "result": {
                    "$ref": "#/definitions/models.Result"
                }
            }
        },
        "models.PropertyResponse": {
            "title": "PropertyResponse",
            "type": "object",
            "properties": {
                "feed": {
                    "type": "integer",
                    "format": "int64"
                },
                "geo_info": {
                    "$ref": "#/definitions/models.GeoInfo"
                },
                "id": {
                    "type": "string"
                },
                "property": {
                    "$ref": "#/definitions/models.PropertyInfo"
                },
                "published": {
                    "type": "boolean"
                }
            }
        },
        "models.Result": {
            "title": "Result",
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer",
                    "format": "int64"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.PropertyResponse"
                    }
                }
            }
        }
    }
}