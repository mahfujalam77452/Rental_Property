                        "type": "string"
                    }
                },
                "LocationID": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "Slug": {
                    "type": "string"
                },
                "Type": {
                    "type": "string"
                }
            }
        },
        "models.Counts": {
            "title": "Counts",
            "type": "object",
